# Copy to ai-service/.env and fill in. This file must never contain real values.
APP_ENV=production
SERVICE_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Backend (service role, local machine only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SNAPSHOT_BUCKET=snapshots

# --- Shared secret expected in the X-Service-Key header ---
# The web app sends the same value from its AI_SERVICE_KEY secret.
AI_SERVICE_KEY=

# --- Model ---
YOLO_MODEL=yolo11n.pt
YOLO_DEVICE=auto
YOLO_IMGSZ=960
YOLO_TRACKER=bytetrack.yaml

# --- Loops ---
CONFIG_REFRESH_SECONDS=10
HEALTH_HEARTBEAT_SECONDS=10
CAMERA_HEARTBEAT_SECONDS=10
INFERENCE_MAX_FPS=10
PROCESS_EVERY_N_FRAMES=1

# --- Detection tuning ---
ASSOCIATION_MARGIN=0.12
DETECTION_GAP_TOLERANCE_SECONDS=0.5

# --- Demo sources (used when the console is in Demo mode) ---
DEMO_VIDEO_PATH=
DEMO_VIDEO_PATHS_JSON=
DEMO_VIDEO_LOOP=true

# --- Camera credentials ---
CAMERA_CREDENTIALS_FILE=./secrets/cameras.json
USE_SUPABASE_CAMERA_CREDENTIALS=false

# --- Storage ---
SNAPSHOT_DIR=./snapshots
STATE_DIR=./state

# --- Telegram (optional) ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_WARNINGS=false